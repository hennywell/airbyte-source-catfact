{
  "streams": [
    {
      "stream": {
        "name": "cat_facts_stream",
        "json_schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "fact": {
              "type": "string",
              "description": "The cat fact text"
            },
            "length": {
              "type": "integer",
              "description": "The length of the fact in characters"
            }
          }
        },
        "supported_sync_modes": ["full_refresh"]
      },
      "sync_mode": "full_refresh",
      "destination_sync_mode": "overwrite"
    },
    {
      "stream": {
        "name": "cat_breeds_stream",
        "json_schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "breed": {
              "type": "string",
              "description": "The breed name"
            },
            "country": {
              "type": "string",
              "description": "The country of origin"
            },
            "origin": {
              "type": "string",
              "description": "The origin description"
            },
            "coat": {
              "type": "string",
              "description": "The coat type"
            },
            "pattern": {
              "type": "string",
              "description": "The coat pattern"
            }
          }
        },
        "supported_sync_modes": ["full_refresh"]
      },
      "sync_mode": "full_refresh",
      "destination_sync_mode": "overwrite"
    }
  ]
}